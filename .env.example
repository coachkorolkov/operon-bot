# Скопируйте файл в .env и заполните значения: cp .env.example .env
# На Amvera эти же значения задаются в разделе «Переменные окружения»,
# а файл .env в репозиторий не коммитится.

# --- Доступ к модели (обязательно) ---------------------------------------
# Вариант А. RouterAI (routerai.ru) — оплата из России, совместим с OpenAI API.
# Адрес и протокол подставляются автоматически, нужен только ключ и модель.
ROUTERAI_API_KEY=
# Точное имя модели из вашего кабинета. Список покажет `python -m app.probe`.
OPERON_MODEL=

# Вариант Б. Любой другой шлюз
# OPERON_LLM_BASE_URL=https://ваш-шлюз/v1
# OPERON_LLM_API_KEY=
# OPERON_LLM_PROTOCOL=openai       # openai | anthropic — подскажет app.probe

# Вариант В. OpenRouter
# OPENROUTER_API_KEY=sk-or-v1-...

# Вариант Г. Прямой доступ к Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# OPERON_MODEL=claude-opus-5

# Подпись валюты в Mini App. RouterAI считает в рублях.
# OPERON_BILLING_CURRENCY=₽

# --- Интернет-поиск ------------------------------------------------------
# Ничего задавать не нужно: без ключей работает бесплатный поиск
# (DuckDuckGo, Bing, Google News, Википедия).
# Платный API вместо бесплатного — любой один ключ:
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=
# Выключить интернет совсем:
# OPERON_SEARCH_PROVIDER=none

# --- Telegram-бот --------------------------------------------------------
# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=
# Белый список Telegram ID через запятую. ОБЯЗАТЕЛЕН: без него бот не
# запустится. Свой ID можно узнать у @userinfobot.
# Сообщения от всех остальных игнорируются молча.
TELEGRAM_ALLOWED_USERS=

# --- Веб-интерфейс -------------------------------------------------------
# Пароль на вход в веб-чат. Обязателен, если приложение слушает внешний
# адрес: на сервере лежит OAuth-токен Google.
OPERON_ACCESS_PASSWORD=
# Ключ подписи сессионных кук. Если пусто — генерируется и хранится на диске.
OPERON_SESSION_SECRET=
OPERON_AUTH_TTL_HOURS=168

# --- Шифрование токена Google -------------------------------------------
# Парольная фраза, которой шифруется google_token.json на постоянном диске.
# Без неё токен лежит открытым текстом: доступ к диску = доступ к Google.
OPERON_TOKEN_KEY=

# --- Организация ---------------------------------------------------------
OPERON_ORG_NAME=OPERON
OPERON_TIMEZONE=Europe/Moscow
# Публичный адрес приложения (https). Нужен для Mini App в Telegram,
# Secure-кук и заголовков OpenRouter.
OPERON_PUBLIC_URL=https://ваш-проект.amvera.io

# --- Приглашения на встречи ----------------------------------------------
# Google не разрешает сервисному аккаунту приглашать участников без
# делегирования в Workspace, поэтому письмо отправляет сам бот — от имени
# владельца календаря. Нужен пароль приложения Gmail (не обычный пароль):
# Google Account → Безопасность → Двухэтапная проверка → Пароли приложений.
# Без этих строк встречи создаются, но участники писем не получают.
# OPERON_SMTP_HOST=smtp.gmail.com
# OPERON_SMTP_PORT=587
# OPERON_SMTP_USER=владелец@gmail.com
# OPERON_SMTP_PASSWORD=пароль-приложения
# OPERON_SMTP_FROM=            # по умолчанию равен OPERON_SMTP_USER
# OPERON_SMTP_COPY_OWNER=true  # копия владельцу: видно, что ушло участникам

# --- Параметры модели ----------------------------------------------------
OPERON_MAX_TOKENS=32000
OPERON_MAX_TOOL_ITERATIONS=24
# Расширения Anthropic. Через сторонний шлюз выключены по умолчанию,
# потому что он не обязан их поддерживать. Включайте, если проверили.
# OPERON_EFFORT=high            # low | medium | high | xhigh | max
# OPERON_USE_EFFORT=false
# OPERON_USE_PROMPT_CACHE=false
# OPERON_WEB_SEARCH=false       # серверный веб-поиск Anthropic

# --- Данные --------------------------------------------------------------
# В контейнере эти пути указывают на постоянный диск /data (см. Dockerfile).
OPERON_KB_DIR=knowledge_base
OPERON_DATA_DIR=data
OPERON_CREDENTIALS_DIR=credentials

# --- «Квант» — основная база знаний (Qdrant) -------------------------------
# Источник правды: бот ищет здесь первым. Проверка: python -m app.quant
# QDRANT_URL=https://qdrantdb-xxxx.amvera.io
# QDRANT_API_KEY=            (можно и QDRANTSERVICEAPI_KEY, как в панели Amvera)
# Коллекции через запятую; пусто — искать во всех.
# QDRANT_COLLECTION=
# Модель, которой наполняли базу: с ней поиск по смыслу, без неё — по словам.
# Запросы идут через RouterAI тем же ключом; свой адрес — QDRANT_EMBEDDING_URL/KEY.
# Квант наполняет платформа базы знаний моделью google/gemini-embedding-2 (3072).
# Можно не задавать: бот сам сверяет модели-кандидаты с векторами базы.
# QDRANT_EMBEDDING_MODEL=google/gemini-embedding-2
# Права по ролям сайта базы знаний: бот читает роль человека (по Telegram ID) из MongoDB
# сайта и показывает только документы этой роли; оттуда же — даты документов.
# Только чтение. Пусто — без этого (роли из QDRANT_ROLES или без фильтра).
# OPERON_MONGODB_URI=mongodb://mongo:27017/operon
# ID ролей из metadata.accessibleByRoles (через запятую). С OPERON_MONGODB_URI — роль по
# умолчанию для тех, у кого роли на сайте нет; без него — фильтр для всех. Пусто — без фильтра.
# QDRANT_ROLES=
# Нужно, только если у коллекции несколько именованных векторов / текст в нестандартном поле.
# QDRANT_VECTOR_NAME=
# QDRANT_TEXT_FIELD=

# --- Голосовые сообщения ---------------------------------------------------
# Распознаются через тот же шлюз (RouterAI). Бот сам пробует способы и запоминает
# рабочий; задавать нужно, только если /check пишет, что распознавание не прошло.
# OPERON_STT_MODEL=openai/whisper-1
# OPERON_STT_CHAT_MODEL=google/gemini-2.5-flash

# --- Google через сервисный аккаунт (рекомендуется) -------------------------
# Без OAuth-экранов и адресов возврата. Ключ — JSON сервисного аккаунта целиком
# (или base64), либо файл /data/credentials/service_account.json.
# Задан ключ — /auth работает так: «/auth почта@домен». См. DEPLOY.md.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Подключить почты заранее, без команд (Telegram ID = почта). После «|» —
# дополнительные календари (рабочие, общие), открытые адресу бота:
# GOOGLE_ACCOUNTS=1107365044=kirill@firma.ru|work@group.calendar.google.com

# --- Google Workspace ----------------------------------------------------
# Клиент задаётся ЛИБО этими двумя переменными (проще на сервере), ЛИБО файлом.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# Тип клиента: desktop или web. Задавайте явно — иначе при заданном
# OPERON_PUBLIC_URL Desktop-клиент получит https-адрес возврата, который
# он не принимает, и ошибка вылезет только после нажатия ссылки.
# OPERON_GOOGLE_CLIENT_TYPE=desktop
# OPERON_GOOGLE_CLIENT_SECRET=credentials/client_secret.json
# По умолчанию: drive.readonly + drive.file + calendar.events.
# Менять набор — значит проходить авторизацию (/auth) заново.
# Чтобы запретить запись: уберите drive.file, calendar.events -> calendar.readonly
# OPERON_GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/calendar.events
# Адрес возврата OAuth. По умолчанию — <OPERON_PUBLIC_URL>/oauth2/callback:
# код приходит на сервер сам. ЭТОТ АДРЕС ОБЯЗАН БЫТЬ ЗАРЕГИСТРИРОВАН в Google
# Cloud Console (Credentials -> ваш клиент -> Authorized redirect URIs),
# иначе Google ответит redirect_uri_mismatch.
# Если публичный адрес не задан, включается запасной режим: localhost и
# ручная вставка кода в чат (годится только для клиента типа Desktop).
# OPERON_OAUTH_REDIRECT_URI=https://ваш-проект.amvera.io/oauth2/callback
# Сколько минут бот ждёт код после /auth.
# OPERON_OAUTH_WAIT_MINUTES=15

# --- Прокси --------------------------------------------------------------
# По умолчанию запросы идут так же, как в системе: через прокси из HTTPS_PROXY
# или из параметров Windows (его включают VPN-программы). Если прокси
# нестабилен («handshake operation timed out»), пустите бота напрямую:
# OPERON_PROXY=none
# Или укажите свой: OPERON_PROXY=http://127.0.0.1:10809

# --- Сервер --------------------------------------------------------------
# В контейнере: 0.0.0.0. Локально оставьте 127.0.0.1.
OPERON_HOST=127.0.0.1
OPERON_PORT=8000

# --- Сессии --------------------------------------------------------------
OPERON_MAX_HISTORY=200
OPERON_SESSION_TTL_MINUTES=720
# Сколько ждать ответа на карточку подтверждения. Без ответа действие
# отменяется — «нет ответа = отказ» должно наступать само, иначе диалог
# зависает навсегда. 0 — не ограничивать.
OPERON_CONFIRMATION_TTL_MINUTES=30

# --- Напоминания ---------------------------------------------------------
# Бот пишет сам: утренняя сводка о просрочках, близких сроках и встречах дня.
# Пустую сводку не шлёт — ежедневное «всё в порядке» перестают читать.
# OPERON_REMINDERS=true
# OPERON_DIGEST_HOUR=9
# Дни недели для сводки, ISO: 1 — понедельник. По умолчанию рабочая неделя.
# OPERON_DIGEST_WEEKDAYS=1-5
# За сколько дней предупреждать о наступающем сроке.
# OPERON_REMIND_BEFORE_DAYS=2
# За сколько минут до встречи из календаря напомнить в Telegram (0 — не напоминать).
# Приходит и в тихие часы: время встречи выбрал человек. Личные «напомни мне в …» — тоже.
# OPERON_MEETING_REMIND_MINUTES=30
# Часы тишины. Равные значения (0-0) отключают тишину.
# OPERON_QUIET_HOURS=22-8
